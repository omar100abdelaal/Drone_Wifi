[Unit]
Description=Drone Control & Video Streaming Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/drone_wifi
ExecStart=/bin/bash /home/pi/drone_wifi/start_all.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
